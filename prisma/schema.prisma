generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
}

model User {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  name         String?
  email        String   @unique
  passwordHash String?
  role         Role     @default(ADMIN)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Project {
  id          String              @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  slug        String              @unique
  summary     String
  description String
  challenge   String?
  solution    String?
  impact      String?
  year        Int?
  client      String?
  categoryId  String              @db.ObjectId
  category    ProjectCategory     @relation(fields: [categoryId], references: [id])
  coverImage  String?
  liveUrl     String?
  githubUrl   String?
  techStack   String[]
  featured    Boolean             @default(false)
  published   Boolean             @default(true)
  screenshots ProjectScreenshot[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([categoryId])
  @@index([published])
}

model ProjectCategory {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  name        String    @unique
  slug        String    @unique
  description String?
  projects    Project[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model ProjectScreenshot {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  projectId String   @db.ObjectId
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  url       String
  alt       String
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([projectId])
}

model Enquiry {
  id               String    @id @default(auto()) @map("_id") @db.ObjectId
  name             String
  email            String
  company          String?
  projectType      String?
  budget           String?
  timeline         String?
  referenceWebsite String?
  fileNames        String[]  @default([])
  message          String
  status           String    @default("NEW")
  notes            String?
  followUpDate     DateTime?
  history          String[]  @default([])
  createdAt        DateTime  @default(now())

  @@index([createdAt])
  @@index([status])
}

model ChatbotLead {
  id                  String    @id @default(auto()) @map("_id") @db.ObjectId
  name                String
  business            String?
  phone               String
  email               String
  businessType        String
  budget              String
  timeline            String?
  requirement         String
  conversationSummary String?
  leadScore           Int?
  estimatedPackage    String?
  requirements        String[]  @default([])
  source              String    @default("WEBSITE_CHATBOT")
  status              String    @default("NEW")
  notes               String?
  followUpDate        DateTime?
  history             String[]  @default([])
  createdAt           DateTime  @default(now())

  @@index([createdAt])
  @@index([status])
}

model EstimatorLead {
  id                 String     @id @default(auto()) @map("_id") @db.ObjectId
  name               String
  businessName       String
  email              String
  phone              String
  businessType       String
  websiteType        String
  pages              String
  features           String[]
  designLevel        String
  requestedTimeline  String
  statedBudget       String
  estimatedPrice     String
  estimatedTimeline  String
  recommendedPackage String
  techStack          String[]
  status             String     @default("NEW")
  notes              String?
  followUpDate       DateTime?
  history            String[]   @default([])
  proposals          Proposal[]
  createdAt          DateTime   @default(now())

  @@index([createdAt])
  @@index([status])
}

model AnalyzerLead {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  email        String
  phone        String?
  websiteUrl   String
  designScore  Int
  mobileScore  Int
  seoScore     Int
  speedScore   Int
  suggestions  String[]
  status       String    @default("NEW")
  notes        String?
  followUpDate DateTime?
  history      String[]  @default([])
  createdAt    DateTime  @default(now())

  @@index([createdAt])
  @@index([status])
}

model Proposal {
  id                 String        @id @default(auto()) @map("_id") @db.ObjectId
  estimatorLeadId    String        @db.ObjectId
  estimatorLead      EstimatorLead @relation(fields: [estimatorLeadId], references: [id], onDelete: Cascade)
  clientName         String
  businessName       String
  recommendedPackage String
  features           String[]
  estimatedPrice     String
  timeline           String
  techStack          String[]
  nextSteps          String[]
  createdAt          DateTime      @default(now())

  @@index([estimatorLeadId])
}

model AIKnowledge {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  type      String
  title     String
  content   String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([isActive])
}

model Testimonial {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  quote     String
  name      String
  role      String
  company   String?
  rating    Int      @default(5)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model HomepageContent {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  key       String   @unique
  title     String
  content   String
  section   String
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SocialLink {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  platform  String   @unique
  label     String
  handle    String
  href      String
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
