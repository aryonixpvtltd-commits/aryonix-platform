generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  CLIENT
}

enum ProjectStatus {
  DISCOVERY
  DESIGN
  DEVELOPMENT
  REVIEW
  DEPLOYED
}

model User {
  id            String          @id @default(auto()) @map("_id") @db.ObjectId
  name          String?
  email         String          @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          Role            @default(CLIENT)
  accounts      Account[]
  sessions      Session[]
  clientProjects ClientProject[]
  invoices      Invoice[]
  messages      ClientMessage[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

model Account {
  id                String  @id @default(auto()) @map("_id") @db.ObjectId
  userId            String  @db.ObjectId
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  sessionToken String   @unique
  userId       String   @db.ObjectId
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  email     String
  tokenHash String   @unique
  expires   DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email])
  @@index([expires])
}

model Project {
  id          String              @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  slug        String              @unique
  summary     String
  description String
  challenge   String?
  solution    String?
  impact      String?
  year        Int?
  client      String?
  categoryId  String              @db.ObjectId
  category    ProjectCategory     @relation(fields: [categoryId], references: [id])
  coverImage  String?
  liveUrl     String?
  githubUrl   String?
  techStack   String[]
  featured    Boolean             @default(false)
  published   Boolean             @default(true)
  screenshots ProjectScreenshot[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([categoryId])
  @@index([published])
}

model ProjectCategory {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  name        String    @unique
  slug        String    @unique
  description String?
  projects    Project[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model ProjectScreenshot {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  projectId String   @db.ObjectId
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  url       String
  alt       String
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([projectId])
}

model ClientProject {
  id          String        @id @default(auto()) @map("_id") @db.ObjectId
  userId      String        @db.ObjectId
  user        User          @relation(fields: [userId], references: [id])
  title       String
  status      ProjectStatus @default(DISCOVERY)
  progress    Int           @default(0)
  files       FileAsset[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model FileAsset {
  id              String        @id @default(auto()) @map("_id") @db.ObjectId
  clientProjectId String        @db.ObjectId
  clientProject   ClientProject @relation(fields: [clientProjectId], references: [id])
  name            String
  url             String
  createdAt       DateTime      @default(now())
}

model Invoice {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id])
  amount    Int
  currency  String   @default("INR")
  status    String   @default("PENDING")
  dueDate   DateTime?
  createdAt DateTime @default(now())
}

model ClientMessage {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject   String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Enquiry {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  name             String
  email            String
  company          String?
  projectType      String?
  budget           String?
  timeline         String?
  referenceWebsite String?
  fileNames        String[] @default([])
  message          String
  status           String   @default("NEW")
  createdAt        DateTime @default(now())
}

model Testimonial {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  quote     String
  name      String
  role      String
  company   String?
  rating    Int      @default(5)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model HomepageContent {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  key       String   @unique
  title     String
  content   String
  section   String
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SocialLink {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  platform  String   @unique
  label     String
  handle    String
  href      String
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
